generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  displayName  String
  passwordHash String
  role         UserRole  @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model SystemConfig {
  key       String   @id
  value     Json
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

enum ProviderProtocol {
  openai
  anthropic
  gemini
}

model ModelProvider {
  id           String           @id @default(cuid())
  name         String           @unique
  protocol     ProviderProtocol
  baseUrl      String
  apiKey       String
  models       Json
  modelCount   Int              @default(0)
  lastTestedAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

/// Persona Center card. `data` holds the full creation draft and is the single
/// editable source; `profile` keeps the card-face fields the wizard does not
/// collect. Channel snapshots are frozen copies and never follow later edits.
model PersonaCard {
  id             String   @id @default(cuid())
  serial         String   @unique
  name           String
  occupation     String   @default("")
  age            Int      @default(0)
  profile        Json
  data           Json
  currentVersion Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions PersonaVersion[]

  @@index([name])
  @@index([updatedAt])
}

/// Immutable snapshot of one save. Versions are never rewritten, so the
/// current term can always be compared with its predecessors.
model PersonaVersion {
  id            String      @id @default(cuid())
  personaId     String
  persona       PersonaCard @relation(fields: [personaId], references: [id], onDelete: Cascade)
  version       Int
  data          Json
  changedFields Json
  changedCount  Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([personaId, version])
}

enum ChatChannelStatus {
  CONNECTING
  ONLINE
  OFFLINE
  ERROR
}

enum ChatConversationKind {
  PRIVATE
  GROUP
}

enum ChatMessageKind {
  TEXT
  IMAGE
  VOICE
  FACE
  MIXED
  SYSTEM
  FORWARD
}

/// Namespace root. Every contact, conversation, message and future persona
/// snapshot belongs to exactly one channel; group/private scopes never create
/// their own namespace.
model ChatChannel {
  id              String            @id @default(cuid())
  platform        String            @default("qq")
  connector       String            @default("NapCat")
  displayName     String
  accountId       String
  avatarUrl       String?
  serverUrl       String
  accessToken     String
  status          ChatChannelStatus @default(CONNECTING)
  lastError       String?
  lastConnectedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  contacts      ChatContact[]
  conversations ChatConversation[]
  messages      ChatMessageRecord[]
  persona       ChatChannelPersona?
  mindSettings  ChatMindSettings?
  relationships PersonaRelationship[]
  groupStances  PersonaGroupStance[]
  memories      PersonaMemory[]
  todos         AgentTodo[]
  intentions    AgentIntention[]
  agentRuns     AgentRun[]
  agentActions  AgentAction[]
  journal       PersonaJournal[]
  stickers      StickerAsset[]

  @@unique([platform, accountId])
}

/// Frozen copy of a Persona Center card. The source card stays untouched; the
/// channel owns this snapshot for the lifetime of the namespace.
model ChatChannelPersona {
  id         String      @id @default(cuid())
  channelId  String      @unique
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  cardId     String
  cardSerial String
  name       String
  identity   String      @default("")
  quote      String      @default("")
  accent     String      @default("brass")
  values     Json
  /// Operator edit log for the channel persona; the only copy of this history.
  history    Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  state         PersonaState?
  relationships PersonaRelationship[]
  groupStances  PersonaGroupStance[]
  memories      PersonaMemory[]
  todos         AgentTodo[]
  intentions    AgentIntention[]
  runs          AgentRun[]
  actions       AgentAction[]
  journal       PersonaJournal[]
  longEvents    PersonaLongEvent[]
  changes       PersonaChangeLog[]
}

/// A channel-scoped participant. The same QQ number under another channel is a
/// separate contact and separate memory namespace.
model ChatContact {
  id         String      @id @default(cuid())
  channelId  String
  channel    ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalId String
  nickname   String
  avatarUrl  String?
  isSelf     Boolean     @default(false)
  lastSeenAt DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  messages      ChatMessageRecord[]
  memberships   ChatGroupMember[]
  relationships PersonaRelationship[]

  @@unique([channelId, externalId])
}

model ChatConversation {
  id                 String               @id @default(cuid())
  channelId          String
  channel            ChatChannel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  kind               ChatConversationKind
  externalId         String
  name               String
  avatarUrl          String?
  memberCount        Int?
  /// A direct line that bypasses the QQ transport but still runs the real mind.
  isDirect           Boolean              @default(false)
  /// Contact speaking on this direct line; shared with its QQ identity when one exists.
  directContactId    String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  lastMessageSender  String?
  /// Persona mind: the last time it intentionally let this exchange end.
  closureClosedAt    DateTime?
  /// explicit-end | topic-done | tired | busy | natural
  closureReason      String?
  closureSummary     String?
  closureNextOpening String?
  /// First incoming message after the close; null once a new close lands.
  closureReopenedAt  DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  messages     ChatMessageRecord[]
  members      ChatGroupMember[]
  groupStances PersonaGroupStance[]
  agentRuns    AgentRun[]
  agentActions AgentAction[]

  @@unique([channelId, kind, externalId])
  @@index([channelId, kind, lastMessageAt])
  @@index([channelId, isDirect])
}

model ChatGroupMember {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        ChatContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  card           String?
  role           String?
  joinedAt       DateTime?
  lastSeenAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([conversationId, contactId])
}

model ChatMessageRecord {
  id                String              @id @default(cuid())
  channelId         String
  channel           ChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      ChatConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId        String?
  senderId          String
  sender            ChatContact         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderName        String
  senderCard        String?
  isSelf            Boolean             @default(false)
  kind              ChatMessageKind     @default(TEXT)
  text              String              @default("")
  segments          Json
  sentAt            DateTime
  /// OneBot message_id from the reply segment, kept even when the target is not stored.
  replyToExternalId String?
  /// Local target row when the quoted message was already ingested; cleared on delete.
  replyToMessageId  String?
  replyTo           ChatMessageRecord?  @relation("ChatMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies           ChatMessageRecord[] @relation("ChatMessageReply")
  /// Rendered quote snapshot so a deleted or out-of-cache target still displays.
  replySnapshot     Json?

  images  ChatImageAsset[]
  voices  ChatVoiceAsset[]
  forward ChatForward?

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
  @@index([channelId, sentAt])
  @@index([replyToMessageId])
}

/// Content metadata keyed by the SHA-256 of the decoded bytes. Many message and
/// forward-node mappings may point at the same row, so repeated images are
/// described once. Bytes live per channel at
/// `data/chat/channels/<channelId>/images/<sha[0..2]>/<sha[2..4]>/<sha[4..6]>/<sha256>.<ext>`.
model ChatMediaObject {
  id          String   @id @default(cuid())
  sha256      String   @unique
  /// Path relative to the owning channel's image root, e.g. `ab/cd/ef/<sha256>.jpg`.
  storagePath String
  mimeType    String?
  byteSize    Int
  width       Int?
  height      Int?
  /// Vision description; null until the description job runs.
  description String?
  createdAt   DateTime @default(now())

  images ChatImageAsset[]
}

/// Image attachment of a message or one forward node. Exactly one owner is set;
/// the database enforces it with a check constraint.
model ChatImageAsset {
  id            String             @id @default(cuid())
  messageId     String?
  message       ChatMessageRecord? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  forwardNodeId String?
  forwardNode   ChatForwardNode?   @relation(fields: [forwardNodeId], references: [id], onDelete: Cascade)
  mediaId       String?
  media         ChatMediaObject?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  url           String
  fileName      String?
  mimeType      String?
  byteSize      Int?
  width         Int?
  height        Int?
  remoteUrl     String?
  /// Zero-based index of the source segment, preserves render order.
  position      Int                @default(0)
  createdAt     DateTime           @default(now())

  @@index([messageId, position])
  @@index([forwardNodeId, position])
  @@index([mediaId])
}

/// Voice attachment of a message or one forward node. Exactly one owner is set;
/// the database enforces it with a check constraint.
model ChatVoiceAsset {
  id            String             @id @default(cuid())
  messageId     String?
  message       ChatMessageRecord? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  forwardNodeId String?
  forwardNode   ChatForwardNode?   @relation(fields: [forwardNodeId], references: [id], onDelete: Cascade)
  url           String
  fileName      String?
  mimeType      String?
  byteSize      Int?
  /// Duration in seconds when provided by the connector.
  duration      Int?
  /// Speech-to-text transcript from NapCat; null for silence or failed requests.
  description   String?
  remoteUrl     String?
  /// Zero-based index of the source segment, preserves render order.
  position      Int                @default(0)
  createdAt     DateTime           @default(now())

  @@index([messageId, position])
  @@index([forwardNodeId, position])
}

enum ChatForwardSource {
  INLINE
  FETCHED
}

enum ChatForwardStatus {
  COMPLETE
  TRUNCATED
  FAILED
}

/// Expanded copy of one merged-forward card. The anchor stays a normal
/// ChatMessageRecord so conversation ordering, previews and dedupe keep
/// working; every visible line lives in ChatForwardNode.
model ChatForward {
  id        String            @id @default(cuid())
  messageId String            @unique
  message   ChatMessageRecord @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// NapCat forward data.id (resid); kept for traceability and future dedupe.
  forwardId String?
  title     String
  source    ChatForwardSource
  status    ChatForwardStatus
  nodeCount Int               @default(0)
  /// Deepest nested level persisted for this card. Nested forwards expand eagerly.
  depth     Int               @default(1)
  errorCode String?
  createdAt DateTime          @default(now())

  nodes ChatForwardNode[]

  @@index([forwardId])
}

/// One line of a merged-forward transcript. Senders are deliberately not
/// materialised as ChatContact rows: they are not participants of the
/// conversation that received the card.
model ChatForwardNode {
  id               String            @id @default(cuid())
  forwardId        String
  forward          ChatForward       @relation(fields: [forwardId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           ChatForwardNode?  @relation("ChatForwardNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         ChatForwardNode[] @relation("ChatForwardNodeTree")
  position         Int
  depth            Int               @default(1)
  senderExternalId String?
  senderName       String
  /// Often missing from forwarded history; null instead of a made-up time.
  sentAt           DateTime?
  kind             ChatMessageKind
  text             String            @default("")
  segments         Json
  createdAt        DateTime          @default(now())

  images ChatImageAsset[]
  voices ChatVoiceAsset[]

  @@index([forwardId, parentId, position])
}

// ---------------------------------------------------------------------------
// Persona mind: continuous self, relationships, memory, agenda and action log.
// ---------------------------------------------------------------------------

/// OFF disables the mind runtime. SHADOW records a turn without sending.
/// APPROVAL stores pending actions for an operator. LIVE executes the plan.
enum PersonaMindMode {
  OFF
  SHADOW
  APPROVAL
  LIVE
}

/// OFF keeps replies chat-only; ACTION allows short stage directions in text;
/// EXPLICIT asks the planner for a scene cue and expands it in a second call.
enum MindSceneDetail {
  OFF
  ACTION
  EXPLICIT
}

enum PersonaMemoryScope {
  SELF
  RELATION
  GROUP
  SCENE
  WORLD
  PROCEDURE
}

enum PersonaMemoryKind {
  EPISODE
  FACT
  PREFERENCE
  PROMISE
  BOUNDARY
  REFLECTION
  PROCEDURE
}

enum PersonaMemorySubjectType {
  PERSON
  GROUP
  SELF
  WORLD
  TOPIC
}

enum PersonaMemoryVisibility {
  PRIVATE
  SCENE
  CHANNEL
  PUBLIC
}

enum PersonaMemoryStatus {
  ACTIVE
  SUPERSEDED
  DISPUTED
  DELETED
}

enum PersonaMemorySourceType {
  MESSAGE
  HEARTBEAT
  WEB
  ADMIN
  INFERENCE
}

enum AgentTodoStatus {
  PENDING
  ACTIVE
  DONE
  CANCELLED
}

enum AgentIntentionStatus {
  PENDING
  SENT
  DEFERRED
  EXPIRED
  CANCELLED
}

enum AgentRunTrigger {
  MESSAGE
  HEARTBEAT
  PROACTIVE
  MANUAL
  PHONE
}

/// What currently has the persona's attention. One body, one focus at a time.
enum PersonaFocusKind {
  CHAT
  PHONE
}

enum PersonaFocusStatus {
  ACTIVE
  PAUSED
  DONE
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum AgentStepType {
  ATTENTION
  RETRIEVAL
  APPRAISAL
  SOCIAL
  TOOL
  PLAN
  EXPRESSION
  WRITEBACK
  CONSOLIDATION
}

enum AgentActionKind {
  MESSAGE
  STICKER
  FACE
  TYPING
  MEMORY
  TODO
}

enum AgentActionStatus {
  PENDING
  APPROVED
  SENT
  FAILED
  SKIPPED
}

/// Per-channel switch and safety budget for the mind runtime.
model ChatMindSettings {
  id                         String          @id @default(cuid())
  channelId                  String          @unique
  channel                    ChatChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  mode                       PersonaMindMode @default(OFF)
  heartbeatEnabled           Boolean         @default(true)
  proactiveEnabled           Boolean         @default(false)
  selfScheduleEnabled        Boolean         @default(true)
  wakeIntervalMinutes        Int             @default(45)
  wakeMinMinutes             Int             @default(10)
  wakeMaxMinutes             Int             @default(240)
  quietIntervalMinutes       Int             @default(90)
  dailyMessageBudget         Int             @default(30)
  /// Model turns spent on proactive/heartbeat wakes per day. 0 means unlimited;
  /// message-triggered replies do not consume this budget.
  proactiveWakeDailyLimit    Int             @default(0)
  /// Minimum seconds between two proactive/heartbeat wakes. 0 disables the gap.
  proactiveWakeMinGapSeconds Int             @default(0)
  maxBeats                   Int             @default(3)
  /// OFF keeps replies chat-only; ACTION allows short stage directions in text;
  /// EXPLICIT lets the runtime expand a scene cue into detailed prose.
  sceneDetail                MindSceneDetail @default(OFF)
  minBeatDelayMs             Int             @default(800)
  maxBeatDelayMs             Int             @default(4000)
  /// After the model decides to reply, other reply tasks in the same
  /// conversation are suppressed for this many seconds. 0 disables the lock.
  replyAvoidSeconds          Int             @default(180)
  /// Private-chat burst merging: wait this many seconds of quiet before one
  /// reply. 0 disables merging.
  privateBurstSeconds        Int             @default(0)
  /// Chance in percent, rolled only on idle heartbeats, that the model gets to
  /// consider a small everyday event. 0 disables life events.
  lifeEventChancePercent     Int             @default(1)
  /// Hard cap on life events per persona-local day so idle days stay quiet.
  lifeEventDailyLimit        Int             @default(1)
  /// Chance in percent, rolled only on idle heartbeats, that the persona gets
  /// to spend the beat reading about something it cares about. 0 disables it.
  curiosityChancePercent     Int             @default(15)
  /// Optional cap per persona-local day; 0 means unlimited.
  curiosityDailyLimit        Int             @default(0)
  /// Minimum hours between self-reflection passes. 0 disables reflection.
  reflectionIntervalHours    Int             @default(6)
  /// Empty means use the built-in mind image-description prompt.
  imageDescriptionPrompt     String          @default("")
  quietHours                 Json?
  providerId                 String?
  model                      String?
  /// Wireless adb device (ip:port) this channel may operate; null disables phone tools.
  phoneDevice                String?
  /// Chance in percent, rolled only on idle heartbeats, that the persona starts
  /// playing with its phone on its own. 0 disables autonomous phone time.
  phonePlayChancePercent     Int             @default(0)
  /// Optional cap on autonomous phone sessions per persona-local day.
  /// 0 means unlimited.
  phonePlayDailyLimit        Int             @default(0)
  /// Autonomous learning from the web/videos. Enabled by default; the heartbeat
  /// only spends one session per interval and only while idle.
  learningEnabled            Boolean         @default(true)
  /// Minimum hours between learning sessions. 0 disables scheduled learning.
  learningIntervalHours      Int             @default(12)
  /// Cap on sources read per persona-local day; 0 means unlimited.
  learningDailySourceLimit   Int             @default(6)
  /// Headless browser tools are available to the planner.
  browserEnabled             Boolean         @default(true)
  /// Let learning sessions write expression notes (how to talk), not just facts.
  styleLearningEnabled       Boolean         @default(true)
  /// Let reflection fold stable expression notes into the persona card.
  stylePromotionEnabled      Boolean         @default(true)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
}

/// The persona's attention focus. A chat interruption pauses the phone focus
/// and resumes it afterwards; rows survive restarts so the scene is not lost.
model PersonaFocus {
  id        String             @id @default(cuid())
  personaId String
  channelId String
  kind      PersonaFocusKind
  status    PersonaFocusStatus @default(ACTIVE)
  /// Set when a chat focus interrupts a phone focus.
  parentId  String?
  goal      String             @default("")
  step      Int                @default(0)
  state     Json               @default("{}")
  pausedAt  DateTime?
  startedAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  endedAt   DateTime?

  @@index([personaId, status, updatedAt])
  @@index([personaId, kind, startedAt])
  @@index([channelId, status])
}

/// Live self-state. One row per channel persona instance.
model PersonaState {
  id                String             @id @default(cuid())
  personaId         String             @unique
  persona           ChatChannelPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  moodValence       Int                @default(0)
  moodArousal       Int                @default(50)
  moodDominance     Int                @default(0)
  energy            Int                @default(70)
  stress            Int                @default(20)
  socialBattery     Int                @default(70)
  attention         Int                @default(60)
  currentActivity   String             @default("")
  /// When `currentActivity` last changed; lets the model see that an activity
  /// has gone stale instead of repeating "正在做饭" for a whole day.
  activitySince     DateTime?
  /// Last time a stale activity was reconsidered, so heartbeats do not retry
  /// the same review every tick when the model keeps the activity unchanged.
  activityCheckedAt DateTime?
  location          String             @default("")
  sleepDebt         Int                @default(0)
  /// Body health. Long sleep events and rough wake-ups move this.
  health            Int                @default(80)
  grooming          Int                @default(70)
  lastWakeAt        DateTime?
  /// Next heartbeat wake; survives the lease so state and scheduler share one row.
  nextWakeAt        DateTime?
  lastHeartbeatAt   DateTime?
  /// Heartbeat worker lease. Null when no worker owns the wake.
  leaseUntil        DateTime?
  leaseOwner        String?
  /// Why the next wake was scheduled (manual, heartbeat safety net, plan...).
  wakeReason        String             @default("")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([nextWakeAt])
}

/// Agent-authored block of time (sleep, focus, away). While ACTIVE, ordinary
/// messages do not reach the planner; repeated directed mentions, wake
/// keywords, or the planned end wake the persona and settle body effects.
model PersonaLongEvent {
  id                String             @id @default(cuid())
  personaId         String
  persona           ChatChannelPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  /// Free-form kind chosen by the agent; SLEEP gets sleep-specific effects.
  kind              String             @default("SLEEP")
  title             String             @default("")
  status            String             @default("ACTIVE")
  reason            String             @default("")
  startedAt         DateTime           @default(now())
  plannedEndAt      DateTime?
  endedAt           DateTime?
  wakeMentions      Int                @default(3)
  wakeWindowMinutes Int                @default(10)
  wakeKeywords      String[]           @default([])
  triggerCount      Int                @default(0)
  lastStimulusAt    DateTime?
  wakeReason        String?
  effects           Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([personaId, status, startedAt])
}

/// Append-only audit for every live value: state, self traits, relationships and
/// group stances. One row per field change; it doubles as the drift quota
/// ledger, so no separate drift-event table is needed.
model PersonaChangeLog {
  id          String             @id @default(cuid())
  personaId   String
  persona     ChatChannelPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  /// STATE | SELF | RELATION | GROUP
  scope       String             @default("STATE")
  /// Contact id / conversation id; empty for STATE and SELF.
  targetId    String             @default("")
  field       String
  beforeValue Json?
  afterValue  Json?
  delta       Int?
  reason      String             @default("")
  /// MANUAL | DRIFT | TOOL | EVENT | EMOTION | TURN | HEARTBEAT | ...
  source      String             @default("")
  runId       String?
  createdAt   DateTime           @default(now())

  @@index([personaId, createdAt])
  @@index([personaId, scope, targetId, field, createdAt])
}

/// Relationship toward one channel contact. All dimensions are -100..100 and
/// are the live values after events.
model PersonaRelationship {
  id                 String             @id @default(cuid())
  personaId          String
  persona            ChatChannelPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  channelId          String
  channel            ChatChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contactId          String
  contact            ChatContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  affinity           Int                @default(0)
  trust              Int                @default(0)
  intimacy           Int                @default(0)
  attraction         Int                @default(0)
  hostility          Int                @default(0)
  fear               Int                @default(0)
  respect            Int                @default(0)
  obligation         Int                @default(0)
  dependency         Int                @default(0)
  possessiveness     Int                @default(0)
  friction           Int                @default(0)
  unresolvedConflict Int                @default(0)
  familiarity        Int                @default(0)
  relationTags       Json?
  addressHere        Json?
  publicMask         Json?
  boundaries         Json?
  openPromises       Json?
  sharedEvents       Json?
  /// Per-person fields without a first-class column (legacy editor extras).
  extras             Json?
  disclosureScope    String             @default("SCENE")
  blocked            Boolean            @default(false)
  mutedUntil         DateTime?
  lastInteractionAt  DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([personaId, contactId])
  @@index([channelId, contactId])
  @@index([personaId, updatedAt])
}

/// Attitude toward one group conversation.
model PersonaGroupStance {
  id             String             @id @default(cuid())
  personaId      String
  persona        ChatChannelPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  channelId      String
  channel        ChatChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   ChatConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  comfort        Int                @default(0)
  belonging      Int                @default(0)
  attention      Int                @default(0)
  formality      Int                @default(0)
  speakRate      Int                @default(0)
  audienceRisk   Int                @default(0)
  role           String             @default("")
  narrative      String             @default("")
  boundaries     Json?
  tabooTopics    Json?
  sceneRules     String             @default("")
  mentionOnly    Boolean            @default(false)
  topic          String             @default("")
  phase          String             @default("")
  /// Per-group fields without a first-class column (legacy editor extras).
  extras         Json?
  lastReadAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([personaId, conversationId])
  @@index([channelId, conversationId])
}

/// One durable memory. Embeddings are stored as Float[] so the first version does
/// not depend on a pgvector extension; retrieval scores them in the application.
model PersonaMemory {
  id               String                   @id @default(cuid())
  personaId        String
  persona          ChatChannelPersona       @relation(fields: [personaId], references: [id], onDelete: Cascade)
  channelId        String
  channel          ChatChannel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversationId   String?
  scope            PersonaMemoryScope
  kind             PersonaMemoryKind
  subjectType      PersonaMemorySubjectType
  subjectId        String                   @default("")
  subjectName      String                   @default("")
  title            String                   @default("")
  content          String
  structured       Json?
  importance       Int                      @default(50)
  confidence       Int                      @default(70)
  emotionalValence Int                      @default(0)
  emotionalArousal Int                      @default(0)
  visibility       PersonaMemoryVisibility  @default(SCENE)
  status           PersonaMemoryStatus      @default(ACTIVE)
  occurredAt       DateTime                 @default(now())
  validFrom        DateTime?
  validTo          DateTime?
  lastRecalledAt   DateTime?
  /// Separate from lastRecalledAt so review rotation does not block decay.
  staleReviewedAt  DateTime?
  recallCount      Int                      @default(0)
  sourceType       PersonaMemorySourceType  @default(INFERENCE)
  sourceIds        String[]                 @default([])
  embedding        Float[]                  @default([])
  consolidatedAt   DateTime?
  supersededById   String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([personaId, status, occurredAt])
  @@index([personaId, subjectType, subjectId])
  @@index([channelId, conversationId, occurredAt])
  @@index([personaId, consolidatedAt])
}

/// Persona-authored (or operator-authored) future task with a wake condition.
model AgentTodo {
  id                    String             @id @default(cuid())
  personaId             String
  persona               ChatChannelPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  channelId             String
  channel               ChatChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  title                 String
  detail                String             @default("")
  kind                  String             @default("follow_up")
  priority              Int                @default(50)
  dueAt                 DateTime?
  wakeCondition         Json?
  recurrence            String?
  status                AgentTodoStatus    @default(PENDING)
  source                String             @default("MIND")
  relatedContactId      String?
  relatedConversationId String?
  completedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([personaId, status, dueAt])
  @@index([personaId, status, createdAt])
}

/// A pending proactive act: the persona wants to say or do something.
model AgentIntention {
  id            String               @id @default(cuid())
  personaId     String
  persona       ChatChannelPersona   @relation(fields: [personaId], references: [id], onDelete: Cascade)
  channelId     String
  channel       ChatChannel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  targetType    String               @default("PERSON")
  targetId      String               @default("")
  reason        String               @default("")
  seed          String               @default("")
  /// care / connect / share / followup / play / learn ... free-form, model-chosen.
  need          String               @default("")
  urgency       Int                  @default(50)
  /// How sure the persona is that this is worth bringing up later (0-100).
  confidence    Int                  @default(50)
  /// How risky it is to bring up unprompted: privacy, timing, rejection (0-100).
  risk          Int                  @default(20)
  /// What the other side actually did after the proactive attempt.
  feedback      String               @default("")
  feedbackAt    DateTime?
  earliestAt    DateTime             @default(now())
  expiresAt     DateTime?
  status        AgentIntentionStatus @default(PENDING)
  attempts      Int                  @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([personaId, status, earliestAt])
}

/// One mind turn, including heartbeat and proactive turns.
model AgentRun {
  id               String             @id @default(cuid())
  personaId        String
  persona          ChatChannelPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  channelId        String
  channel          ChatChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversationId   String?
  conversation     ChatConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId        String?
  /// PersonaFocus this run belongs to, so phone sessions read as one timeline.
  focusId          String?
  trigger          AgentRunTrigger    @default(MESSAGE)
  mode             PersonaMindMode    @default(LIVE)
  status           AgentRunStatus     @default(RUNNING)
  providerId       String?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  decision         Json?
  socialRead       Json?
  plan             Json?
  scene            Json?
  error            String?
  startedAt        DateTime           @default(now())
  finishedAt       DateTime?
  steps            AgentStep[]
  actions          AgentAction[]

  @@index([personaId, startedAt])
  @@index([conversationId, startedAt])
  @@index([focusId, startedAt])
  @@index([status, startedAt])
}

/// One heartbeat attempt, including beats that never reached the planner.
/// Plain ids (no relations) so the log survives persona/channel cleanup.
model MindHeartbeatLog {
  id             String   @id @default(cuid())
  personaId      String
  channelId      String
  /// RUN | IDLE | GATED | LONG_EVENT | NO_CONVERSATION | REPLY_LOCK | DISABLED | FAILED
  status         String
  reason         String
  mode           String
  quiet          Boolean  @default(false)
  dueTodos       Int      @default(0)
  dueIntentions  Int      @default(0)
  unconsolidated Int      @default(0)
  lifeEvent      Boolean  @default(false)
  curiosity      Boolean  @default(false)
  reflection     Boolean  @default(false)
  learning       Boolean  @default(false)
  /// AgentRun created by this heartbeat, when the model actually ran.
  runId          String?
  detail         Json?
  createdAt      DateTime @default(now())

  @@index([personaId, createdAt])
  @@index([channelId, createdAt])
  @@index([runId])
}

/// One autonomous learning session: which sources were read and what stuck.
/// Plain ids so the log survives persona/channel cleanup.
model MindLearningLog {
  id         String    @id @default(cuid())
  personaId  String
  channelId  String
  /// HEARTBEAT | MANUAL
  trigger    String    @default("HEARTBEAT")
  /// RUNNING | SUCCEEDED | FAILED
  status     String    @default("RUNNING")
  reason     String    @default("")
  sources    Json      @default("[]")
  learned    Json      @default("[]")
  styleNotes Json      @default("[]")
  summary    String    @default("")
  error      String?
  runId      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([personaId, startedAt])
  @@index([channelId, startedAt])
}

/// A learned way of speaking. SELF is the persona's general voice; RELATION is
/// an adaptation for one contact. This is not a copy of the persona card.
model PersonaStyleNote {
  id            String    @id @default(cuid())
  personaId     String
  channelId     String
  /// SELF | RELATION
  scope         String    @default("SELF")
  contactId     String    @default("")
  /// length | punctuation | particles | openings | humor | rhythm | vocabulary | tone
  dimension     String    @default("tone")
  content       String
  samples       Json      @default("[]")
  sources       Json      @default("[]")
  confidence    Int       @default(50)
  evidenceCount Int       @default(1)
  /// ACTIVE | PAUSED | PROMOTED
  status        String    @default("ACTIVE")
  appliedCount  Int       @default(0)
  lastAppliedAt DateTime?
  lastSeenAt    DateTime  @default(now())
  promotedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([personaId, status])
  @@index([channelId, contactId, status])
}

model AgentStep {
  id         String        @id @default(cuid())
  runId      String
  run        AgentRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  type       AgentStepType
  title      String        @default("")
  input      Json?
  output     Json?
  durationMs Int?
  error      String?
  createdAt  DateTime      @default(now())

  @@index([runId, createdAt])
}

/// Outbound/persistence action journal. `idempotencyKey` makes retries safe.
model AgentAction {
  id             String             @id @default(cuid())
  runId          String?
  run            AgentRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  personaId      String
  persona        ChatChannelPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  channelId      String
  channel        ChatChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   ChatConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  kind           AgentActionKind
  payload        Json
  status         AgentActionStatus  @default(PENDING)
  idempotencyKey String             @unique
  sentMessageId  String?
  error          String?
  approvedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([personaId, createdAt])
  @@index([status, createdAt])
}

/// Local sticker library metadata. Bytes live under the owning channel at
/// `data/chat/channels/<channelId>/stickers/<filePath>`; the row carries the
/// description and embedding used for mood/scene retrieval.
model StickerAsset {
  id          String      @id @default(cuid())
  channelId   String
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sha256      String
  filePath    String
  mimeType    String?
  byteSize    Int         @default(0)
  width       Int?
  height      Int?
  tags        String[]    @default([])
  description String      @default("")
  embedding   Float[]     @default([])
  enabled     Boolean     @default(true)
  usageCount  Int         @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([channelId, sha256])
  @@index([channelId, enabled, lastUsedAt])
}

/// Cached understanding of a public video, keyed by platform video id so the
/// persona can recall it without downloading the same video twice.
model VideoInsight {
  id          String   @id @default(cuid())
  platform    String   @default("bilibili")
  videoId     String
  url         String   @default("")
  title       String   @default("")
  author      String   @default("")
  durationSec Int      @default(0)
  description String   @default("")
  tags        String[] @default([])
  coverUrl    String?
  stats       Json?
  transcript  String   @default("")
  comments    String   @default("")
  summary     String   @default("")
  keyPoints   String[] @default([])
  framesPath  String?
  frameCount  Int      @default(0)
  watchedAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platform, videoId])
  @@index([lastUsedAt])
}

/// One row per LLM call. Raw request/response text is kept for the newest 200
/// calls; older attributed calls keep only usage so reports can aggregate them.
/// Run-scoped token totals stay authoritative on AgentRun.
model LlmCallLog {
  id               String   @id @default(cuid())
  /// The mind run that produced this call, so the trace can show its prompts.
  runId            String?
  /// Attribution for calls outside a run (vision descriptions, screenshots).
  channelId        String?
  personaId        String?
  source           String   @default("llm")
  providerId       String?
  providerName     String?
  model            String?
  system           String   @default("")
  prompt           String?
  response         String?
  imageCount       Int      @default(0)
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  error            String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([source, createdAt])
  @@index([runId, createdAt])
  @@index([channelId, createdAt])
  @@index([personaId, createdAt])
}

/// First-person journal entry produced by deep consolidation.
model PersonaJournal {
  id                    String             @id @default(cuid())
  personaId             String
  persona               ChatChannelPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)
  channelId             String
  channel               ChatChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  date                  String
  content               String
  mood                  String             @default("")
  consolidatedMemoryIds String[]           @default([])
  createdAt             DateTime           @default(now())

  @@unique([personaId, date])
  @@index([personaId, createdAt])
}
